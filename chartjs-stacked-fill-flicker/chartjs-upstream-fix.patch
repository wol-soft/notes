@@ -296,4 +296,44 @@ describe('Plugin.filler', function() {
       ]);
     });
   });
+
+  describe('dataset.fill: stack', function() {
+    // An x that is within the _isBetween epsilon of a vertex of the line below, but not equal to it,
+    // makes LineElement.interpolate() return one point per adjacent segment (an array). Animations
+    // produce such x values near their end when datasets' x-animations started a few ms apart.
+    [1e-9, -1e-9].forEach(function(delta) {
+      it('should fill when a point x differs from the line below by ' + delta + 'px', function() {
+        var chart = window.acquireChart({
+          type: 'line',
+          data: {
+            labels: ['a', 'b', 'c', 'd', 'e'],
+            datasets: [
+              {data: [1, 2, 1, 2, 1], fill: 'stack', backgroundColor: '#0000ff'},
+              {data: [1, 1, 1, 1, 1], fill: 'stack', backgroundColor: '#ff0000'}
+            ]
+          },
+          options: {
+            animation: false,
+            elements: {
+              line: {borderWidth: 0},
+              point: {radius: 0}
+            },
+            scales: {
+              x: {display: false},
+              y: {display: false, stacked: true}
+            }
+          }
+        });
+
+        var point = chart.getDatasetMeta(1).data[2];
+        point.x += delta;
+        chart.draw();
+
+        // middle of the second dataset's band (stacked from 1 to 2) at label 'c'
+        var x = Math.round(point.x);
+        var y = Math.round(chart.scales.y.getPixelForValue(1.5));
+        expect(Array.from(chart.ctx.getImageData(x, y, 1, 1).data)).toEqual([255, 0, 0, 255]);
+      });
+    });
+  });
 });
